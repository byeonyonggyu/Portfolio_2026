{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go Live: 변경 사항 자동 빌드",
      "type": "process",
      "command": "node",
      "args": ["node_modules/vite/bin/vite.js", "build", "--watch", "--outDir", ".live-preview"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(building|build started)",
          "endsPattern": "built in"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    }
  ]
}
